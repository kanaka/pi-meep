{
  "name": "@kanaka/pi-meep",
  "version": "0.2.0",
  "type": "module",
  "description": "Notification sounds for pi: meep when done, distinct error sounds for final failures and pending auto-retries.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "notification",
    "sound",
    "audio"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kanaka/pi-meep"
  },
  "files": [
    "index.ts",
    "sounds.ts",
    "scripts/render.ts",
    "assets/meep.png",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "scripts": {
    "check": "node scripts/render.ts --check",
    "render": "node scripts/render.ts",
    "play": "node scripts/render.ts --play"
  }
}
